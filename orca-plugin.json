{
  "manifestVersion": 2,
  "id": "rails-syntax",
  "name": "Rails Syntax",
  "version": "0.2.0",
  "description": "Ruby and ERB syntax highlighting for Rails, using the grammars of the Ruby LSP VS Code extension.",
  "author": {
    "name": "DDan",
    "url": "https://github.com/ddantran"
  },
  "repository": "https://github.com/ddantran/orca-rails-syntax",
  "license": "MIT",
  "engines": {
    "orca": ">=1.4.246"
  },
  "execution": "data",
  "contributes": {
    "syntaxes": [
      {
        "id": "ruby",
        "title": "Ruby",
        "scopeName": "source.ruby",
        "path": "syntaxes/ruby.tmLanguage.json",
        "configuration": "syntaxes/ruby-configuration.json",
        "extensions": [
          ".rb", ".builder", ".eye", ".fcgi", ".gemspec", ".god", ".irbrc", ".jbuilder",
          ".mspec", ".pluginspec", ".podspec", ".prawn", ".pryrc", ".rabl", ".rake", ".rbi",
          ".rbuild", ".rbw", ".rbx", ".ru", ".ruby", ".spec", ".thor", ".watchr"
        ],
        "filenames": [
          ".irbrc", ".pryrc", ".simplecov", "Appraisals", "Berksfile", "Brewfile", "Buildfile",
          "Capfile", "Dangerfile", "Deliverfile", "Fastfile", "Gemfile", "Guardfile", "Jarfile",
          "Mavenfile", "Podfile", "Puppetfile", "Rakefile", "Snapfile", "Steepfile", "Thorfile",
          "Vagrantfile"
        ]
      },
      {
        "id": "erb",
        "title": "ERB",
        "scopeName": "text.html.erb",
        "path": "syntaxes/erb.tmLanguage.json",
        "configuration": "syntaxes/erb-configuration.json",
        "extensions": [".erb", ".rhtml", ".rhtm"]
      },
      {
        "id": "html-for-erb",
        "title": "HTML (for ERB)",
        "scopeName": "text.html.basic",
        "path": "syntaxes/html.tmLanguage.json"
      }
    ]
  }
}
